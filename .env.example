# http
PORT=3000
NODE_ENV=development

# persistence: sqlite | mongodb
DB_DRIVER=sqlite

# sqlite
SQLITE_DATABASE=./data/monitor.sqlite

# mongodb (used when DB_DRIVER=mongodb)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=camillia_monitor

# ingest auth: comma-separated keys accepted on write endpoints (X-API-Key).
# Empty disables the check entirely — set this before exposing the service.
INGEST_API_KEYS=
